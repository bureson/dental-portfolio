# Firebase configuration for signing in at /prihlaseni.
#
# Copy this file to `.env.local` and fill in the values from the Firebase
# console: Project settings → General → Your apps → Web app → SDK setup and
# configuration.
#
# The values are inlined into the static build, so they end up in the
# downloaded code — that is fine for Firebase web configuration, it is not a
# secret. Protection comes from the user list in Authentication and from
# Security Rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dentist-portfolio-9ea33.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dentist-portfolio-9ea33

# Realtime Database instance holding the vocabulary. Create the database first
# (Build → Realtime Database) and copy the URL it gives you.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
