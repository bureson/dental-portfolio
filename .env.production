# Firebase web configuration, used by `next build`.
#
# Committed on purpose. These values are a public project identifier, not a
# secret — they are already visible in the built bundle that every visitor
# downloads. What actually protects the data is Authentication (who may sign
# in) and database.rules.json (who may read and write what).
#
# CI builds from a clean checkout where .env.local does not exist, so without
# this file the deployed site would ship with no Firebase config and both
# sign-in and the vocabulary would silently stop working.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBZgURxnsaZoNOS09iJCbWmRe109ZUPwdA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dentist-portfolio-9ea33.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://dentist-portfolio-9ea33-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dentist-portfolio-9ea33
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dentist-portfolio-9ea33.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=68165205689
NEXT_PUBLIC_FIREBASE_APP_ID=1:68165205689:web:e3e74d29a221b6f6496568
